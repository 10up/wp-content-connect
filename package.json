{
  "name": "wp-content-connect",
  "version": "1.6.0",
  "description": "WordPress library that enables direct relationships for posts to posts and posts to users.",
  "homepage": "https://github.com/10up/wp-content-connect",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "10up",
    "email": "opensource@10up.com",
    "url": "https://10up.com",
    "role": "developer"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build-js": "browserify -t vueify -e assets/js/src/content-connect.js -o assets/js/content-connect.js",
    "watch-js": "watchify -v -t vueify -e assets/js/src/content-connect.js -o assets/js/content-connect.js",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:clean": "wp-env clean all",
    "wp-env:destroy": "wp-env destroy",
    "test:setup": "npm run wp-env:start",
    "test": "npm run test:unit",
    "test:unit": "vendor/bin/phpunit -c phpunit.unit.xml",
    "test:integration": "wp-env run tests-cli bash -c 'cd wp-content/plugins/wp-content-connect && [ ! -d vendor ] && composer install --no-interaction --quiet; vendor/bin/phpunit -c phpunit.integration.xml'",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@wordpress/env": "^9.0.0",
    "babel-core": "^6.26.3",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-runtime": "^6.26.0",
    "browserify": "^16.2.3",
    "node-sass": "^9.0.0",
    "vue": "^2.4.4",
    "vue-resource": "^1.5.3",
    "vuedraggable": "^2.14.1",
    "vueify": "^9.4.1",
    "watchify": "^4.0.0"
  }
}
